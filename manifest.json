{
  "manifest_version": 2,
  "name": "Research Library Paper Importer",
  "version": "0.8.6",
  "description": "Import local research papers and supplementary files into Zotero as linked attachments.",
  "homepage_url": "https://github.com/Royychinn/research-library-paper-importer",
  "author": "Royychinn",
  "icons": {
    "48": "chrome/content/icons/favicon.svg",
    "96": "chrome/content/icons/favicon.svg"
  },
  "applications": {
    "zotero": {
      "id": "research-library-paper-importer@ychin.com",
      "update_url": "https://raw.githubusercontent.com/Royychinn/research-library-paper-importer/main/updates.json",
      "strict_min_version": "6.999",
      "strict_max_version": "10.0.*"
    }
  }
}
